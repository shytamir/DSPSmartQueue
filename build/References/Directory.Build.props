<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../../artifacts/ci-references/managed/</OutputPath>
    <NoWarn>$(NoWarn);0169;0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="UnityEngine.CoreModule" HintPath="../../../artifacts/ci-references/managed/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
